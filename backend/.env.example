# Copy to .env and fill in real values. Never commit the real file.

# PostgreSQL connection string
DATABASE_URL=postgresql://citysquare:citysquare@127.0.0.1:5432/citysquare

# REQUIRED in production, at least 32 characters. Used to sign JWTs.
# Rotating this value does NOT affect waiter PINs (see PIN_PEPPER).
JWT_SECRET=replace-with-a-long-random-value-at-least-32-chars
JWT_EXPIRES_IN=12h

# Optional: pepper for the deterministic waiter-PIN lookup column.
# Defaults to JWT_SECRET when unset. Set this to rotate JWT_SECRET safely,
# then re-set waiter PINs once.
# PIN_PEPPER=another-long-random-value

PORT=3000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max PIN attempts per IP per minute.
PIN_RATE_LIMIT_MAX=20
