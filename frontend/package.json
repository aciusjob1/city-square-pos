{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staff": "vite --mode staff",
    "dev:waiter": "vite --mode waiter",
    "build": "tsc -b && vite build",
    "build:staff": "tsc -b && vite build --mode staff",
    "build:waiter": "tsc -b && vite build --mode waiter",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:staff": "vite preview --outDir dist-staff",
    "preview:waiter": "vite preview --outDir dist-waiter"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.8.2",
    "vite": "^8.3.6"
  }
}
